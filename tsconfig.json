{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"declaration": true,
		"outDir": "dist",
		"rootDir": "./src",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		"alwaysStrict": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strictNullChecks": false
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
